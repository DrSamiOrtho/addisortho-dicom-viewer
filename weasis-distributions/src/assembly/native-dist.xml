<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">

  <id>native-dist</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <!-- Copy jws jars -->
      <directory>target/tmp</directory>
      <outputDirectory>bin-dist/weasis</outputDirectory>
      <includes>
        <include>/*.jar</include>
        <include>bundle/*.jar${xz.ext}</include>
        <include>bundle-i18n/*.xz</include>
        <include>bundle-i18n/buildNumber.properties</include>
      </includes>
    </fileSet>
    <fileSet>
      <!-- Direct resources copy -->
      <directory>src/main/resources-native</directory>
      <outputDirectory>bin-dist</outputDirectory>
      <fileMode>0755</fileMode>
      <directoryMode>0755</directoryMode>
    </fileSet>
    <fileSet>
      <!-- copy resources -->
      <directory>resources</directory>
      <outputDirectory>bin-dist/weasis/resources</outputDirectory>
    </fileSet>
    <fileSet>
      <!-- Third-party notice generated by the root build (license-maven-plugin) -->
      <directory>../target/generated-resources/legal</directory>
      <outputDirectory>bin-dist/weasis/resources/legal</outputDirectory>
    </fileSet>
    <fileSet>
      <!-- copy OSGI framework config -->
      <directory>etc/config</directory>
      <outputDirectory>bin-dist/weasis/conf</outputDirectory>
      <includes>
        <include>*.json</include>
      </includes>
      <filtered>true</filtered>
    </fileSet>
    <fileSet>
      <!-- copy the build scripts -->
      <directory>script</directory>
      <outputDirectory>build/script</outputDirectory>
      <includes>
        <include>build.properties</include>
      </includes>
      <filtered>true</filtered>
    </fileSet>
    <fileSet>
      <!-- copy the build scripts -->
      <directory>script</directory>
      <outputDirectory>build/script</outputDirectory>
      <excludes>
        <exclude>build.properties</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <!-- copy the build scripts -->
      <directory>docker</directory>
      <outputDirectory>build/docker</outputDirectory>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>../LICENSE.Apache-2.0</source>
      <outputDirectory>bin-dist/weasis/resources/legal/licenses</outputDirectory>
      <destName>Apache-2.0.txt</destName>
    </file>
    <file>
      <source>../LICENSE.EPL-2.0</source>
      <outputDirectory>bin-dist/weasis/resources/legal/licenses</outputDirectory>
      <destName>EPL-2.0.txt</destName>
    </file>
  </files>
</assembly>
